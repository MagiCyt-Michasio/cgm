# Local app listener. Keep loopback when using Nginx/Cloudflare Tunnel.
HOST=127.0.0.1
PORT=3050

# MongoDB credentials. Do not commit real credentials.
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=admin
# Set this to the ACTUAL database containing Nightscout entries and treatments.
MONGODB_DB=nightscout
